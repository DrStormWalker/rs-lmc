%init(
    stack size      = 0,
    call stack size = 1,
)
%_start

%print:
    LDA arr_len
    STA print_len

    LDA #arr
    STA print_ptr

%print_loop:
    LDA @print_ptr
    OUT

    LDA print_ptr
    ADD #1
    STA print_ptr

    LDA print_len
    SUB #1
    STA print_len
    SUB #1
    BRP print_loop

    %ret

print_len DAT
print_ptr DAT

%bubble_sort:
    LDA #arr
    STA bubble_sort_ptr

    LDA arr_len
    SUB #2
    ADD bubble_sort_ptr
    STA bubble_sort_i

%bubble_sort_i_loop:
    LDA bubble_sort_ptr
    STA bubble_sort_j

    LDA #0
    STA bubble_sort_swapped

%bubble_sort_j_loop:
    LDA @bubble_sort_j
    STA bubble_sort_tmp

    LDA bubble_sort_j
    ADD #1
    STA bubble_sort_j_1

    LDA bubble_sort_tmp
    SUB @bubble_sort_j_1

    BRP bubble_sort_swap
    BRA bubble_sort_no_swap

%bubble_sort_swap:
    LDA @bubble_sort_j_1
    STA @bubble_sort_j

    LDA bubble_sort_tmp
    STA @bubble_sort_j_1

    LDA #1
    STA bubble_sort_swapped

%bubble_sort_no_swap:
    LDA bubble_sort_j_1
    STA bubble_sort_j
    SUB bubble_sort_i

    SUB #1
    BRP bubble_sort_cont
    BRA bubble_sort_j_loop

%bubble_sort_cont:
    LDA bubble_sort_swapped
    BRZ bubble_sort_ret

    LDA bubble_sort_i
    SUB #1
    STA bubble_sort_i
    SUB bubble_sort_ptr
    BRP bubble_sort_i_loop

%bubble_sort_ret:
    %ret

bubble_sort_tmp     DAT
bubble_sort_i       DAT
bubble_sort_j       DAT
bubble_sort_j_1     DAT
bubble_sort_ptr     DAT
bubble_sort_swapped DAT

%_start:
    ; %bsub( print )

    %bsub( bubble_sort )
    %bsub( print )

    HLT

arr_len DAT 10

arr     DAT 5
arr_1   DAT 3
arr_2   DAT 2
arr_3   DAT 8
arr_4   DAT 9
arr_5   DAT 5
arr_6   DAT 15
arr_7   DAT 17
arr_8   DAT 4
arr_9   DAT 10
