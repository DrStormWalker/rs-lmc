%init(
    stack size      = 64,
    call stack size = 64,
)
%_start

%print:
    %pop
    STA print_ptr

    %pop
    STA print_len

%print_loop:
    LDA @print_ptr
    OUT

    LDA print_ptr
    ADD #1
    STA print_ptr

    LDA print_len
    SUB #1
    STA print_len
    SUB #1
    BRP print_loop

    %ret

print_len DAT
print_ptr DAT

%partition:
    %pop
    STA partition_j
    SUB #1
    STA partition_i

    %pop
    ADD #1
    STA partition_high

    LDA @partition_high
    STA partition_pivot

%partition_loop:
    LDA partition_pivot
    SUB @partition_j

    BRP partition_swap
    BRA partition_no_swap

%partition_swap:
    LDA partition_i
    ADD #1
    STA partition_i

    LDA @partition_i
    STA partition_tmp

    LDA partition_j

    LDA @partition_j
    STA @partition_i

    LDA partition_tmp
    STA @partition_j

%partition_no_swap:
    LDA partition_j
    ADD #1
    STA partition_j

    SUB partition_high
    BRP partition_end
    BRA partition_loop

%partition_end:
    LDA partition_i
    ADD #1
    STA partition_i

    LDA @partition_i
    STA partition_tmp

    LDA @partition_high
    STA @partition_i

    LDA partition_tmp
    STA @partition_high

    LDA partition_i
    %push

    %ret

partition_i     DAT
partition_pivot DAT
partition_j     DAT
partition_high  DAT
partition_tmp  DAT

%_quicksort:
    ; LDA #1000
    ; OUT
    %pop
    STA quicksort_low
    ; OUT

    ; LDA #1001
    ; OUT
    %pop
    STA quicksort_high
    ; OUT

    SUB quicksort_low
    BRZ quicksort_end
    BRP quicksort_cont
    BRA quicksort_end

%quicksort_cont:
    LDA quicksort_high
    %push 
    SUB #1
    %push

    LDA quicksort_low
    %push

    %bsub( partition )
    %pop
    STA quicksort_pivot
    %push

    SUB #1
    %push

    LDA quicksort_low
    %push

    %bsub( _quicksort )

    %pop
    ADD #1
    %push

    %bsub( _quicksort )

%quicksort_end:
    %ret
    

%quicksort:
    %pop
    STA quicksort_low

    %pop
    ADD quicksort_low
    SUB #1
    %push

    LDA quicksort_low
    %push

    BRA _quicksort

quicksort_low   DAT
quicksort_high  DAT
quicksort_pivot DAT

%_start:
    LDA arr_len
    %push
    LDA #arr
    %push
    %bsub( quicksort )

    LDA arr_len
    %push
    LDA #arr
    %push
    %bsub( print )

    HLT

arr_len DAT 1000

