%init(
    stack size      = 2,
    call stack size = 1,
)
%_start

%print:
    %pop
    STA print_ptr

    %pop
    STA print_len

%print_loop:
    LDA @print_ptr
    OUT

    LDA print_ptr
    ADD #1
    STA print_ptr

    LDA print_len
    SUB #1
    STA print_len
    SUB #1
    BRP print_loop

    %ret

print_len DAT
print_ptr DAT

%bubblesort:
    %pop
    STA bubblesort_ptr

    %pop
    SUB #2
    ADD bubblesort_ptr
    STA bubblesort_i

%bubblesort_i_loop:
    LDA bubblesort_ptr
    STA bubblesort_j

    LDA #0
    STA bubblesort_swapped

%bubblesort_j_loop:
    LDA @bubblesort_j
    STA bubblesort_tmp

    LDA bubblesort_j
    ADD #1
    STA bubblesort_j_1

    LDA bubblesort_tmp
    SUB @bubblesort_j_1

    BRP bubblesort_swap
    BRA bubblesort_no_swap

%bubblesort_swap:
    LDA @bubblesort_j_1
    STA @bubblesort_j

    LDA bubblesort_tmp
    STA @bubblesort_j_1

    LDA #1
    STA bubblesort_swapped

%bubblesort_no_swap:
    LDA bubblesort_j_1
    STA bubblesort_j
    SUB bubblesort_i

    SUB #1
    BRP bubblesort_cont
    BRA bubblesort_j_loop

%bubblesort_cont:
    LDA bubblesort_swapped
    BRZ bubblesort_ret

    LDA bubblesort_i
    SUB #1
    STA bubblesort_i
    SUB bubblesort_ptr
    BRP bubblesort_i_loop

%bubblesort_ret:
    %ret

bubblesort_tmp     DAT
bubblesort_i       DAT
bubblesort_j       DAT
bubblesort_j_1     DAT
bubblesort_ptr     DAT
bubblesort_swapped DAT

%_start:
    LDA arr_len
    %push
    LDA #arr
    %push
    %bsub( bubblesort )

    LDA arr_len
    %push
    LDA #arr
    %push
    %bsub( print )

    HLT

arr_len DAT 100

arr     DAT 95
arr_1   DAT 14
arr_2   DAT 99
arr_3   DAT 8
arr_4   DAT 52
